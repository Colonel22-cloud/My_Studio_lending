# ============================================================
# AI Studio API — sample.env
#
# НАПОЛНЕНИЕ:  cp sample.env .env   → затем вписать значения и ключи.
# Удалите неиспользуемые комментарии или просто оставьте.
#
# ⚠  .env содержит секреты: не публиковать, не коммитить,
#    на VPS — только root-доступ на чтение.
# ============================================================

# ===== API =====
# Генерация:  python -c "import secrets; print(secrets.token_hex(32))"
SITE_TOKEN=<сгенерировать_значение>

# CORS: домены, с которых сайт обращается к API.
# Локальная разработка — Live Server:
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
# После запуска сайта добавить в список боевой домен:
# ALLOWED_ORIGINS=["https://ваш-домен"]


# ===== LLM — ВЫБЕРИТЕ ОДНОГО ПРОВАЙДЕРА =====
# Вписанные ниже значения заполнить своими ключами.

# --- Вариант A: Yandex AI Studio (YandexGPT) — РЕКОМЕНДУЕТСЯ ---
# Документы: https://aistudio.yandex.ru/docs/ru/ai-studio/concepts/openai-compatibility
# Как получить ключ: ИИ Studio (yandex.cloud) → сервисный аккаунт с ролью
# `ai.languageModels.user` → IAM → создать API-ключ. Понадобится folder_id каталога.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_AUTH_SCHEME=Api-Key
LLM_API_KEY=<ваш_Api-Ключ_Yandex>
# Модель в URI-формате Yandex (вписать свой folder_id; /latest можно убрать):
LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# РЕКОМЕНДУЕТСЯ: чат-боту — лёгкая/дешёвая модель (в те же <folder_id>),
# квиз-аудиторам (генерация отчётов) останется большая LLM_MODEL:
CHAT_LLM_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
LLM_TEMPERATURE=0.4

# --- Вариант B: GigaChat (Сбер) ---
# ⚠ У GigaChat access-токен живёт ~30 минут и выдаётся через OAuth из
# авторизационного ключа — для него нужно реализовать автообновление токена
# в app/services/llm.py (см. README, раздел «Развитие»), либо использовать SDK.
# LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# LLM_AUTH_SCHEME=Bearer
# LLM_API_KEY=<ваши_данные_для_выдачи_токена>
# LLM_MODEL=GigaChat
# LLM_TEMPERATURE=0.4


# ===== SMTP / Email =====
# Пока почты на домене нет — оставить пустым: письма будут логироваться в консоль.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Куда слать уведомления о горячих лидах (ваша почта Yandex/Mail.ru):
MANAGER_EMAIL=
# После подключения Yandex 360:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=audit@ваш-домен.ru
# SMTP_PASSWORD=<пароль приложения Яндекса>
# EMAIL_FROM=audit@ваш-домен.ru
# MANAGER_EMAIL=<личная почта менеджера>

# Ежедневный дайджест метрик менеджеру: во сколько по МСК отправлять
# (сервер сам раз в день шлёт письмо; работает, если заполнены SMTP и MANAGER_EMAIL)
# DIGEST_HOUR=9


# ===== Пути / БД (обычно менять не нужно) =====
PROMPTS_DIR=../
KNOWLEDGE_DIR=../
REPORT_TEMPLATE=app/templates/report.html
DB_URL=sqlite:///./data/aistudio.db